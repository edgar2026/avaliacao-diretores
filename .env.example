# Copie para .env e preencha com as credenciais públicas do projeto Supabase.
# Apenas a URL pública e a chave publicável (anon/publishable).
# NUNCA use service_role, senha de banco ou token pessoal no frontend.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=SUA_CHAVE_PUBLICA_ANON
